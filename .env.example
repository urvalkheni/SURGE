# ==============================================================================
# RenewableIQ — Environment Variables Template
# ==============================================================================
# Rename this file to .env.local for local development.
# NEVER commit real credentials, tokens, or production secrets to source control.

# NextAuth / Auth.js Encryption Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Leave blank to run in automatic Demo Operator session mode.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL for the external ML / FastAPI forecasting backend (e.g. http://localhost:8000)
# Leave blank or omit to use the built-in deterministic demo fallback provider.
NEXT_PUBLIC_API_BASE_URL=
# Legacy alias accepted by the current API client. Prefer NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_URL=
# Set true to force deterministic demo providers even when an API URL is set.
NEXT_PUBLIC_FORCE_DEMO_MODE=false

# Browser-safe Supabase project settings. Obtain these from the Supabase project
# Connect dialog. The anon key is safe to expose; RLS remains the data boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
