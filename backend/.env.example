SURGE_ENVIRONMENT=development
SURGE_API_PREFIX=/api/v1
SURGE_CORS_ORIGINS=http://localhost:3000
# Required for authenticated persistence endpoints.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; never expose this value to Next.js.
SUPABASE_SERVICE_ROLE_KEY=
# Optional when validating Supabase JWTs locally. Prefer JWKS in production.
SUPABASE_JWT_SECRET=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
